# Single-page app routing: serve index.html for any path that is not a real file or folder
# (replaces the catch-all route the Express server provided on Replit)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Renamed guide URL
  RewriteRule ^guides/questions-to-ask-before-hiring-an-online-coach/?$ /guides/questions-before-hiring-an-online-coach/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>
